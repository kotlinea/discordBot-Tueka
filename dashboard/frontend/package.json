{
  "name": "tueka-dashboard-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "test:docs-a11y": "playwright test --config playwright.docs.config.ts",
    "typecheck": "tsc -b --pretty false",
    "api:generate": "python ../../scripts/generate_api.py",
    "api:check": "python ../../scripts/generate_api.py --check"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.6",
    "@fontsource/noto-sans-jp": "^5.2.6",
    "@fontsource/space-grotesk": "^5.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.85.5",
    "i18next": "^25.4.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
