FROM docker:28.5.1-cli@sha256:9190b0613792e658a7783cf14b2d5ace5941bb68ede7276922ea36ee457d76ad AS docker-cli
FROM ghcr.io/astral-sh/uv:0.8.22@sha256:9874eb7afe5ca16c363fe80b294fe700e460df29a55532bbfea234a0f12eddb1 AS uv
FROM zricethezav/gitleaks:v8.28.0@sha256:cdbb7c955abce02001a9f6c9f602fb195b7fadc1e812065883f695d1eeaba854 AS gitleaks
FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS node
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285 AS python
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH" TUEKA_TOOLS=1
# Freeze the Debian archive as well as the base image. No rolling apt sources.
RUN rm /etc/apt/sources.list.d/debian.sources && printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z trixie main\n' > /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY requirements.lock /opt/requirements.lock
RUN python -m venv /opt/venv && pip install --no-cache-dir --require-hashes -r /opt/requirements.lock && pip check
COPY --from=uv /uv /usr/local/bin/uv
COPY scripts/tools.py /opt/tools.py
WORKDIR /workspace
ENTRYPOINT ["python", "/opt/tools.py"]

FROM python AS secrets
COPY --from=gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks

FROM python AS manager
ENV TUEKA_DOCKER_MANAGER=1
COPY --from=docker-cli /usr/local/bin/docker /usr/local/libexec/docker-real
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/lib/docker/cli-plugins
COPY deploy/docker_bridge.py /opt/tool-code/deploy/docker_bridge.py
COPY scripts/docker_proxy.py /usr/local/bin/docker
RUN chmod +x /usr/local/bin/docker

FROM mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e AS web-base
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV CI=true PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 TUEKA_TOOLS=1
WORKDIR /workspace
ENTRYPOINT ["python3", "/opt/tools.py"]

# Lock repair must remain runnable when package.json and package-lock disagree.
FROM web-base AS web-lock
COPY scripts/tools.py /opt/tools.py

FROM web-base AS web
WORKDIR /opt/deps
COPY dashboard/frontend/package*.json dashboard/frontend/
COPY docs/package*.json docs/
RUN node -e "if(require('./dashboard/frontend/package-lock.json').packages['node_modules/playwright'].version!=='1.62.1')throw Error('Update the pinned Playwright image to match package-lock.json')" \
    && npm --prefix dashboard/frontend ci --no-audit --no-fund && npm --prefix docs ci --no-audit --no-fund
COPY scripts/tools.py /opt/tools.py
WORKDIR /workspace
