# Canonical configure template. Generated environment-specific values replace blank required fields.
# Re-running configure appends missing keys only; existing values (including empty values) are kept.
TUEKA_ENV=
DATABASE_URL=
DISCORD_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_SAFE_BROWSING_API_KEY=

# Discord OAuth2 dashboard (set the Redirect URI in Discord Developer Portal exactly)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
SESSION_SECRET=
DASHBOARD_BASE_URL=
DASHBOARD_HTTPS_ONLY=true

# Optional runtime settings
DATA_DIR=/data
LOG_LEVEL=INFO
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
X_BEARER_TOKEN=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_WEBHOOK_SECRET=
SOCIAL_X_MODE=poll
SOCIAL_MAX_SUBSCRIPTIONS_PER_PROVIDER=10
SOCIAL_POLL_INTERVAL_SECONDS=120
INSTAGRAM_RSS_URL_TEMPLATE=
INSTAGRAM_RSS_AUTH_TOKEN=
REACTION_ROLE_MAX_MAPPINGS_PER_MESSAGE=20
TICKET_ENCRYPTION_KEY=
TICKET_S3_ENDPOINT_URL=
TICKET_S3_REGION=
TICKET_S3_BUCKET=
TICKET_S3_ACCESS_KEY_ID=
TICKET_S3_SECRET_ACCESS_KEY=
TICKET_S3_PREFIX=ticket-transcripts

# Developer-only HTTP API documentation (also requires TUEKA_ENV=dev)
TUEKA_API_DOCS_ENABLED=false

# Monitoring (missing secrets stay empty on existing deployments; never rotate implicitly)
MONITORING_TOKEN=
# Thresholds below are numeric settings, not credential values.
HEARTBEAT_MAX_AGE_SECONDS=30
OUTBOX_MAX_AGE_SECONDS=300

# Container asset paths; normally keep these image defaults
TUEKA_FRONTEND_DIST=/opt/tueka-assets/ui
TUEKA_DOCS_DIST=/opt/tueka-assets/docs
