[Unit]
Description=Tueka Social Notification Worker
After=network-online.target
Wants=network-online.target

[Service]
User=tueka
WorkingDirectory=/opt/discordBot-Tueka
EnvironmentFile=/opt/discordBot-Tueka/.env
ExecStart=/opt/discordBot-Tueka/.venv/bin/python social_worker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
