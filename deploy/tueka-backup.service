[Unit]
Description=Tueka consistent offline backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=tueka-operator
SupplementaryGroups=docker
WorkingDirectory=/srv/tueka
ExecStart=/usr/bin/docker compose --env-file deploy/compose.env -f compose.tools.yaml run --rm -T recovery backup --config-dir data/environments/prod --backup-root data/backups --resume-source
UMask=0077
TimeoutStartSec=1h
