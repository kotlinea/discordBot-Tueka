[Unit]
Description=Tueka consistent offline backup
After=docker.service

[Service]
Type=oneshot
User=tueka-operator
SupplementaryGroups=docker
WorkingDirectory=/srv/tueka
ExecCondition=/usr/bin/test -S /var/run/docker.sock
ExecStart=/usr/bin/docker compose --env-file deploy/compose.env -f compose.tools.yaml run --rm --build --no-deps -T recovery scheduled-backup --backup-config data/backup.json
UMask=0077
TimeoutStartSec=1h
