[Unit]
Description=Tueka consistent offline backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=tueka-operator
SupplementaryGroups=docker
WorkingDirectory=/srv/tueka
ExecStart=/srv/tueka/.venv/bin/python scripts/recovery.py backup --config-dir /srv/tueka-config/prod --backup-root /srv/tueka-backups --resume-source
UMask=0077
TimeoutStartSec=1h
