FROM node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553
ENV CI=true
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY dashboard/frontend/package.json dashboard/frontend/package-lock.json ./dashboard/frontend/
COPY docs/package.json docs/package-lock.json ./docs/
RUN npm --prefix dashboard/frontend ci --no-audit --no-fund && npm --prefix docs ci --no-audit --no-fund
RUN cd dashboard/frontend && npx playwright install --with-deps chromium
COPY . .
CMD ["node", "scripts/web-baseline.mjs"]
