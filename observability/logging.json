{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"safe": {"()": "observability.logging.SafeJsonFormatter", "service": "dashboard"}},
  "handlers": {"stdout": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "safe"}},
  "root": {"handlers": ["stdout"], "level": "INFO"},
  "loggers": {
    "uvicorn": {"handlers": [], "propagate": true},
    "uvicorn.error": {"handlers": [], "propagate": true},
    "uvicorn.access": {"handlers": [], "propagate": false}
  }
}
