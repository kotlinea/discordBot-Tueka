# Do not commit .env. Reissue the credentials that were formerly stored in bot.py.
DISCORD_TOKEN=replace_with_a_new_discord_bot_token
GEMINI_API_KEY=replace_with_a_new_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_SAFE_BROWSING_API_KEY=

# Discord OAuth2 dashboard (set the Redirect URI in Discord Developer Portal exactly)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://bot.example.com/oauth/callback
SESSION_SECRET=replace_with_a_long_random_secret
DASHBOARD_BASE_URL=https://bot.example.com
DASHBOARD_HTTPS_ONLY=true

# Optional runtime settings
DATA_DIR=data
DATABASE_PATH=data/tueka.sqlite3
BANNED_WORDS_FILE=banned_words.csv
LOG_LEVEL=INFO
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
X_BEARER_TOKEN=
SOCIAL_TOKEN_ENCRYPTION_KEY=
