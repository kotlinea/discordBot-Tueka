# Do not commit .env. 
DISCORD_TOKEN=replace_with_a_new_discord_bot_token
GEMINI_API_KEY=replace_with_a_new_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_SAFE_BROWSING_API_KEY=

# Discord OAuth2 dashboard (set the Redirect URI in Discord Developer Portal exactly)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://bot.example.com/oauth/callback
SESSION_SECRET=replace_with_a_long_random_secret
DASHBOARD_BASE_URL=https://bot.example.com
DASHBOARD_HTTPS_ONLY=true

# Optional runtime settings
BOT_INVITE_URL=
DATA_DIR=data
DATABASE_URL=postgresql://tueka:change-me@127.0.0.1:5432/tueka
LOG_LEVEL=INFO
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
X_BEARER_TOKEN=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_WEBHOOK_SECRET=replace_with_a_random_32_byte_secret
SOCIAL_X_MODE=stream
SOCIAL_MAX_SUBSCRIPTIONS_PER_PROVIDER=10
SOCIAL_POLL_INTERVAL_SECONDS=120
INSTAGRAM_RSS_URL_TEMPLATE=
INSTAGRAM_RSS_AUTH_TOKEN=
REACTION_ROLE_MAX_MAPPINGS_PER_MESSAGE=20
TICKET_ENCRYPTION_KEY=
TICKET_S3_ENDPOINT_URL=
TICKET_S3_REGION=
TICKET_S3_BUCKET=
TICKET_S3_ACCESS_KEY_ID=
TICKET_S3_SECRET_ACCESS_KEY=
TICKET_S3_PREFIX=ticket-transcripts

# Developer-only HTTP API documentation (also requires TUEKA_ENV=dev)
TUEKA_API_DOCS_ENABLED=false

# Developer-only API docs; also requires TUEKA_ENV=dev
TUEKA_API_DOCS_ENABLED=false
